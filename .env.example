# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_LOG_FILE=logs/app.log
REQUEST_BODY_MAX_BYTES=16384
IP_HASH_SALT=replace-with-a-random-production-secret
TRUST_PROXY_HEADERS=false
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_contact

# Redis and rate limiting
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=900
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# AI (the application uses fallback when disabled or no key is provided)
AI_ENABLED=false
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_TIMEOUT_SECONDS=10

# Email (Docker Compose uses its bundled Mailpit SMTP automatically)
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_OWNER_EMAIL=
SMTP_USE_TLS=true

# Product metrics (endpoint is hidden when empty)
METRICS_API_KEY=
