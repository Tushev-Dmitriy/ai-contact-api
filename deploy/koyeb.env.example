# Non-secret production settings
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_LOG_FILE=/app/logs/app.log
TRUST_PROXY_HEADERS=true
CORS_ALLOWED_ORIGINS=["https://your-frontend.example"]
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=900
AI_ENABLED=true
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.1-8b-instant
AI_TIMEOUT_SECONDS=10
EMAIL_ENABLED=true
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USE_TLS=true

# Create these values as Koyeb Secrets, never commit real values.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@NEON_HOST/DATABASE?ssl=require
REDIS_URL=rediss://default:PASSWORD@UPSTASH_HOST:PORT
IP_HASH_SALT=GENERATE_A_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
AI_API_KEY=GROQ_API_KEY
SMTP_USERNAME=BREVO_SMTP_LOGIN
SMTP_PASSWORD=BREVO_SMTP_KEY
SMTP_FROM_EMAIL=VERIFIED_BREVO_SENDER
SMTP_OWNER_EMAIL=CONTACT_RECIPIENT
METRICS_API_KEY=GENERATE_A_RANDOM_ADMIN_KEY
